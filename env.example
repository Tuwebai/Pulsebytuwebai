# Variables de entorno para Pulse by TuWebAI

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ConfiguraciÃ³n de la aplicaciÃ³n
VITE_PUBLIC_URL=https://pulse.tuweb-ai.com
VITE_APP_NAME=Pulse
VITE_APP_VERSION=1.0.0

# GA4 / Pulse
GOOGLE_ANALYTICS_CREDENTIALS='{service_account_json}'
GA4_DRY_RUN=true

# Edge Function security
CRON_SECRET=your_random_secret_here
EMAIL_DRY_RUN=true
ZEPTOMAIL_SEND_MAIL_TOKEN=your_zeptomail_send_mail_token_here
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
SMTP_FROM=pulse@tuweb-ai.com
EMAIL_FROM_NAME=Pulse by TuWebAI
EMAIL_REPLY_TO=pulse@tuweb-ai.com


# GitHub OAuth Integration
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret_here
# Para desarrollo: http://localhost:8083/auth/github/callback
# Para producciÃ³n: https://pulse.tuweb-ai.com/auth/github/callback
VITE_GITHUB_REDIRECT_URI=https://pulse.tuweb-ai.com/auth/github/callback
VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# LinkedIn OAuth Integration
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Encryption Key for Token Storage (opcional - se genera automÃ¡ticamente si no se proporciona)
VITE_ENCRYPTION_KEY=your_32_character_encryption_key_here

# ConfiguraciÃ³n de desarrollo
NODE_ENV=development
VITE_DEBUG_MODE=true
